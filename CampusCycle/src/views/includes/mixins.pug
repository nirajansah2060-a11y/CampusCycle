mixin listingCard(item, compact)
  article.listing-card(class=compact ? 'listing-card-compact' : '')
    a.listing-card__image-wrap(href=`/items/${item.id}`)
      img.listing-card__image(src=item.cover_image_url || '/placeholders/item-placeholder.png', alt=item.title)
      span.exchange-pill(class=`exchange-${item.exchange_type.toLowerCase()}`)= item.exchange_type
      if item.display_price
        span.price-pill= item.display_price
    .listing-card__body
      .card-meta-top
        span.card-kicker= item.primary_tag_name
        span.card-time= item.created_label
      h3
        a(href=`/items/${item.id}`)= item.title
      p.card-description= item.description
      .tag-chip-row
        each tag in item.tag_list.slice(0, 3)
          a.tag-chip(href=`/tags/${tag.id}/items`) ##{tag.name.replace(/\s+/g, '')}
      .listing-card__footer
        a.owner-inline(href=`/users/${item.owner_id}`)
          img.avatar-image(src=item.owner_avatar_url || '/placeholders/profile-placeholder.png', alt=item.owner_name)
          span= item.owner_name
        a.card-link(href=`/items/${item.id}`) View Details

mixin memberCard(user)
  article.member-card
    .member-card__top
      img.profile-photo(src=user.avatar_url || '/placeholders/profile-placeholder.png', alt=user.name)
      if user.badge_label
        span.badge-label= user.badge_label
    h3
      a(href=`/users/${user.id}`)= user.name
    p.member-degree= user.department
    p.member-bio= user.bio
    .member-stats
      .member-stat
        strong= user.listing_count
        span Listings
      .member-stat
        strong Member since
        span= user.joined_label
    a.button.button-soft.button-block(href=`/users/${user.id}`) View Profile
