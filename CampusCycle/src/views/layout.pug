doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title #{title} | #{site.name}
    meta(name='description', content='CampusCycle campus resource sharing prototype')
    link(rel='stylesheet', href='/style.css')
  body
    include includes/mixins
    .app-shell
      header.site-header
        .container.header-row
          a.brand(href='/')
            .brand-icon
              span ∞
            span.brand-text #{site.name}
          nav.primary-nav(aria-label='Primary')
            a(class=currentPath === '/' ? 'is-active' : '', href='/') Home
            a(class=currentPath.startsWith('/items') ? 'is-active' : '', href='/items') Browse
            a(class=currentPath.startsWith('/tags') ? 'is-active' : '', href='/tags') Categories
            a(class=currentPath.startsWith('/users') ? 'is-active' : '', href='/users') Users
            if currentUser
              a(class=currentPath.startsWith('/messages') ? 'is-active' : '', href='/messages') Messages
          .header-actions
            if currentUser
              a.button.button-outline(href='/items/new') Create Listing
              a.icon-button(href='/messages', aria-label='Messages') ✉
              a.profile-chip(href=`/users/${currentUser.id}`)
                img.profile-chip__avatar(src=currentUser.avatar_url || '/placeholders/profile-placeholder.png', alt=currentUser.name)
                span.profile-chip__name= currentUser.name.split(' ')[0]
              form(action='/signout', method='post')
                button.button.button-dark(type='submit') Sign out
            else
              a.link-button(href='/signin') Sign In
              a.button.button-primary(href='/signup') Get Started
      if flash
        .flash-banner(class=`flash-${flash.type}`)
          .container
            p= flash.message
      main
        block content
      footer.site-footer
        .container.footer-grid
          .footer-brand
            .brand.footer-brandmark
              .brand-icon
                span ∞
              span.brand-text #{site.name}
            p Building a more sustainable campus community by making it easy to trade, sell and share academic resources.
          .footer-column
            h4 Platform
            a(href='/items') Browse listings
            a(href='/tags') Categories
            a(href='/users') Community
          .footer-column
            h4 Support
            a(href='/signin') Sign in
            a(href='/signup') Create account
            a(href='/items/new') Create listing
          .footer-column
            h4 Sprint 3 routes
            a(href='/items/1') Listing detail
            a(href='/users/6') User profile
            a(href='/tags/1/items') Category results
        .container.footer-bottom
          span © 2026 CampusCycle. Prototype aligned to Sprint 3 requirements.
          a(href='/health') Health API
    script(src='/app.js')
