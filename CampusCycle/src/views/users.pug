extends layout

block content
  section.page-hero.page-hero--compact
    .container
      h1 Community Members
      p Meet the students sharing resources on campus. Connect, trade, and learn together.
      form.search-strip(action='/users', method='get')
        input.input(type='text', name='q', value=filters.q, placeholder='Search users by name, course, or resource')
        button.button.button-primary(type='submit') Search
      .chip-row
        each label, key in roleFilters
          a.filter-chip(class=filters.role === key ? 'is-active' : '', href=`/users?role=${key}`)= label
  section.page-section
    .container
      .member-grid
        each user in users
          +memberCard(user)
      if !users.length
        .empty-state
          h3 No members matched your search
          p Try a different keyword or reset the active filter.
          a.button.button-primary(href='/users') Show all members
