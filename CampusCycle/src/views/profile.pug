extends layout

block content
  section.page-section
    .container
      .profile-hero-card
        img.profile-hero-card__avatar(src=user.avatar_url || '/placeholders/profile-placeholder.png', alt=user.name)
        .profile-hero-card__copy
          h1= user.name
          p.profile-role #{user.major}
          p.profile-hero-card__bio= user.bio
          .inline-meta
            span Joined #{user.joined_label}
            span #{user.campus}
        if currentUser && currentUser.id === user.id
          a.button.button-primary(href='/items/new') Add Listing
      .stat-row
        .mini-stat-card
          span Listings Posted
          strong= user.listing_count
        .mini-stat-card
          span Categories Shared
          strong= user.categories_shared
        .mini-stat-card
          span Community Points
          strong= user.points
        .mini-stat-card
          span Response Rate
          strong #{user.response_rate}%
      .profile-layout
        aside.profile-sidebar
          .surface-card
            h3 About #{user.name.split(' ')[0]}
            p= user.bio
            ul.info-list
              li= user.email
              li #{user.badge_label}
              li #{user.department}
          .surface-card
            h3 Skills and Interests
            .tag-chip-row
              each tag in userTags
                a.tag-chip(href=`/tags/${tag.id}/items`)= tag.name
          .surface-card
            h3 Points Activity
            if pointEvents && pointEvents.length
              ul.points-list
                each event in pointEvents
                  li
                    strong +#{event.points}
                    span #{event.description} · #{event.created_label}
            else
              p No point events recorded yet.
          if currentUser && currentUser.id !== user.id
            a.button.button-soft.button-block(href=`/messages?receiver_id=${user.id}`) Message #{user.name.split(' ')[0]}
          else if !currentUser
            a.button.button-soft.button-block(href='/signin') Sign in to message
        .profile-main
          .section-heading.row-between
            div
              h2 Active Listings
              p.section-subtitle #{user.name.split(' ')[0]} currently has #{items.length} listing#{items.length === 1 ? '' : 's'} live.
            if items.length
              a.text-link(href=`/items?q=${user.name.split(' ')[0]}`) View all
          if currentUser
            .surface-card.profile-message-history
              .row-between
                div
                  if currentUser.id === user.id
                    h3 Recent Messages
                    p.section-subtitle Latest sent and received item messages for your account.
                  else
                    h3 Recent Conversation
                    p.section-subtitle Latest messages between you and #{user.name.split(' ')[0]}.
                if currentUser.id === user.id
                  a.button.button-outline.button-small(href='/messages') Open Inbox
                else
                  a.button.button-outline.button-small(href=`/messages?receiver_id=${user.id}`) Open Chat
              if recentMessages && recentMessages.length
                .message-preview-list
                  each message in recentMessages
                    article.message-preview
                      strong #{message.direction}
                      span #{message.created_label}
                      if message.listing_title
                        a.text-link(href=`/items/${message.listing_id}`)= message.listing_title
                      p= message.body
              else
                if currentUser.id === user.id
                  p.helper-text No messages yet. Browse an item and message a student to start a conversation.
                else
                  p.helper-text No messages with #{user.name.split(' ')[0]} yet. Start the conversation from here.
          if items.length
            .listing-grid.two-col
              each item in items
                +listingCard(item)
          else
            .empty-state
              h3 No active listings yet
              p This member has not posted any listings yet.
