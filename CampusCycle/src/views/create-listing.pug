extends layout

block content
  section.page-hero.page-hero--compact
    .container
      h1 Create a New Listing
      p Share your textbooks, gear, or notes with the campus community.
  section.page-section
    .container.create-layout
      form.surface-card.form-panel.form-panel--listing(action='/items/new', method='post', enctype='multipart/form-data')
        h2 Item Images
        label.upload-zone(for='coverImage')
          input#coverImage(type='file', name='coverImage', accept='.png,.jpg,.jpeg,.webp', hidden)
          span.upload-zone__icon ⤴
          strong Click to upload or drag and drop
          span PNG, JPG or WEBP, max 5MB
        .form-grid
          .field-span-2
            label.field-label(for='title') Title
            input.input(data-preview-title type='text', id='title', name='title', placeholder='e.g. Calculus Revision Notes', required)
          .field-col
            label.field-label(for='primary_tag_id') Category
            select.select(data-preview-category id='primary_tag_id', name='primary_tag_id', required)
              option(value='') Select a category
              each category in categories
                option(value=category.id)= category.name
          .field-col
            label.field-label(for='condition_label') Condition
            select.select(id='condition_label', name='condition_label')
              option(value='Like New') Like New
              option(value='Very Good') Very Good
              option(value='Good', selected) Good
              option(value='Used') Used
              option(value='Digital Print') Digital Print
          .field-span-2
            label.field-label Resource Type
            .segmented-row
              label.segmented-option
                input(type='radio', name='exchange_type', value='Gift', checked)
                span Gift
              label.segmented-option
                input(type='radio', name='exchange_type', value='Loan')
                span Loan
              label.segmented-option
                input(type='radio', name='exchange_type', value='Swap')
                span Swap
          .field-span-2
            label.field-label(for='description') Description
            textarea.input.textarea(data-preview-description id='description', name='description', rows='5', placeholder='Describe your item, mention any highlights or missing parts...', required)
          .field-col
            label.field-label(for='price') Price
            input.input(type='number', id='price', name='price', min='0', step='0.01', placeholder='0.00')
          .field-col
            label.field-label(for='location') Pickup Location
            input.input(type='text', id='location', name='location', placeholder='Library entrance')
          .field-span-2
            label.field-label(for='response_note') Response Note
            input.input(type='text', id='response_note', name='response_note', placeholder='Usually within 1 day')
          .field-span-2
            label.field-label(for='galleryImages') Gallery Images
            input.input(type='file', id='galleryImages', name='galleryImages', accept='.png,.jpg,.jpeg,.webp', multiple)
          .field-span-2
            label.field-label Tags
            .tag-selector
              each category in categories
                label.tag-selector__item
                  input(type='checkbox', name='tag_ids', value=category.id)
                  span= category.name
        button.button.button-secondary.button-block(type='submit') Post Listing
      aside.preview-column
        .surface-card.preview-card
          h3 Preview Card
          .preview-card__image
            img#previewImage(src='/placeholders/item-placeholder.png', alt='Listing preview image')
            span.exchange-pill#previewType Gift
          .preview-card__content
            span.card-kicker#previewCategory Select category
            h4#previewTitle Your title will appear here
            p.card-description#previewDescription Short description preview for your listing.
            .tag-chip-row
              span.tag-chip#previewOwner Your account
        .tips-card
          h3 Pro Tips for Quick Exchanges
          ul
            li Use high quality PNG photos in good lighting.
            li Be honest about the condition of the item.
            li Use relevant tags to help people find you.
