extends layout

block content
  section.auth-page
    .auth-page__panel
      .auth-page__brand
        a.brand(href='/')
          .brand-icon
            span ∞
          span.brand-text CampusCycle
        h1 Join thousands of students saving money and building community.
        p The exclusive marketplace for verified students to buy, sell, and trade books, furniture, and more within their university.
      .auth-card
        h2 Welcome Back
        p Please enter your student credentials to sign in.
        form.form-stack(action='/signin', method='post')
          label.field-label(for='email') Student Email
          input.input(type='email', id='email', name='email', placeholder='name@university.edu', required)
          .row-between
            label.field-label(for='password') Password
            span.helper-text Demo password is admin
          input.input(type='password', id='password', name='password', placeholder='Enter password', required)
          button.button.button-primary.button-block(type='submit') Sign In
        .auth-divider
          span or continue with
        a.button.button-outline.button-block(href='/signup') Create Account
