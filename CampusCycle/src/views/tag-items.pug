extends layout

block content
  section.page-hero.page-hero--compact
    .container
      h1 #{tag.name} Listings
      p= tag.description
      .chip-row
        each category in categories
          a.filter-chip(class=category.id === tag.id ? 'is-active' : '', href=`/tags/${category.id}/items`)= category.name
  section.page-section
    .container
      if items.length
        .listing-grid.three-col
          each item in items
            +listingCard(item)
      else
        .empty-state
          h3 No listings in this category yet
          p Add a new listing or browse other categories.
          a.button.button-primary(href='/items/new') Create a listing
